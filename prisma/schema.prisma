generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Medico {
  id            Int        @id @default(autoincrement())
  nome          String
  crm           String     @unique
  especialidade String
  consultas     Consulta[]
}

model Consulta {
  id       Int      @id @default(autoincrement())
  medicoId Int
  medico   Medico   @relation(fields: [medicoId], references: [id])
  paciente String
  dataHora DateTime
}